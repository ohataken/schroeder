{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
  },
  "permissions": {
    "deny": [
      "Bash(docker port *)",
      "Bash(docker compose *)",
      "Bash(docker start *)"
    ],
    "ask": [
      "mcp__plugin_figma_figma__create_design_system_rules",
      "mcp__plugin_Notion_notion__notion-update-page",
      "Bash(gh api * -f body=*)",
      "Bash(gh api * -F body=*)",
      "Bash(gh api * --field body=*)",
      "Bash(gh api * --raw-field body=*)",
      "Bash(gh issue comment *)",
      "Bash(gh pr review * --comment *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)"
    ],
    "allow": [
      "mcp__plugin_sentry_sentry__search_issues",
      "mcp__plugin_sentry_sentry__get_sentry_resource",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_figma_figma__get_design_context",
      "mcp__plugin_figma_figma__get_variable_defs",
      "mcp__plugin_figma_figma__get_code_connect_map",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__plugin_figma_figma__get_figjam",
      "mcp__plugin_figma_figma__whoami",
      "mcp__plugin_Notion_notion__notion-fetch",
      "mcp__plugin_Notion_notion__notion-update-page",
      "Bash(pup monitors list *)",
      "Bash(pup events list *)",
      "Bash(pup metrics query *)",
      "Bash(pup traces search *)",
      "Bash(pup slos history *)",
      "Bash(pup slos status *)",
      "Bash(pup slos get *)",
      "Bash(pup slo list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh repo view *)",
      "Bash(gh run download *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh api *)",
      "Bash(gh search *)",
      "Bash(gh label list *)",
      "Bash(gh browse *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git reset *)",
      "Bash(git add *)",
      "Bash(git apply *)",
      "Bash(git commit *)",
      "Bash(git branch -m *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(code *)",
      "Bash(wait *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(diff *)",
      "Bash(cat *)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' idle \"$PPID\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tee -a /Users/ken.ohata/GitHub/eduardo-kirk/session-end.jsonl | eduardo-kirk session-end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tee -a /Users/ken.ohata/GitHub/eduardo-kirk/notification.jsonl | eduardo-kirk notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' awaiting \"$PPID\" ctx"
          }
        ]
      }
    ]
  },
  "statusLine": {
  },
  "enabledPlugins": {
  },
  "extraKnownMarketplaces": {
  },
  "language": "japanese",
  "tui": "fullscreen",
  "theme": "light"
}
